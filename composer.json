{
    "name": "anjan-talukdar/laravel-gst-invoice",
    "description": "A production-ready, lightweight, and extensible GST Invoicing Engine for Laravel supporting Goods (HSN) and Services (SAC).",
    "keywords": [
        "laravel",
        "gst",
        "invoice",
        "invoicing",
        "hsn",
        "sac",
        "tax",
        "india",
        "billing"
    ],
    "homepage": "https://github.com/anjan-talukdar/laravel-gst-invoice",
    "license": "MIT",
    "authors": [
        {
            "name": "Anjan Talukdar",
            "email": "anjan@example.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AnjanTalukdar\\GstInvoice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnjanTalukdar\\GstInvoice\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnjanTalukdar\\GstInvoice\\GstInvoiceServiceProvider"
            ],
            "aliases": {
                "GstInvoice": "AnjanTalukdar\\GstInvoice\\Facades\\GstInvoice"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
